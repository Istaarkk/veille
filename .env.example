# Clé API Claude pour le brief IA (https://console.anthropic.com). Sans clé, seul le fil est généré.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Optionnel
# VEILLE_MODELE=claude-opus-5-5
# FENETRE_HEURES=36
# MAX_PAR_SOURCE=15
# Âge (heures) au-delà duquel le brief IA est régénéré ; le fil, lui, est rafraîchi à chaque exécution
BRIEF_MAX_AGE_HEURES=5
